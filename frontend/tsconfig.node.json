{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": [
      "esnext"
    ],
    "types": [
      "node"
    ],
    "resolveJsonModule": true
  },
  "include": [
    "vite.config.ts",
    "*.config.ts",
    "scripts/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "src"
  ]
}

