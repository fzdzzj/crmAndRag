{
  "name": "crm-vue3",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "vitest run",
    "preview": "vite preview",
    "lint": "eslint --ext .js,.vue --fix src && pnpm type-check",
    "lint:check": "eslint --ext .js,.vue src",
    "format": "prettier ./src  --write",
    "gen:api": "npx @hey-api/openapi-ts -f ./openapi-ts.config.ts",
    "prepare": "node scripts/setup-hooks.mjs",
    "check": "pnpm lint && pnpm format",
    "precommit:check": "pnpm lint:check && pnpm type-check:check",
    "type-check": "pnpm type-check:app  && pnpm type-check:config",
    "type-check:check": "pnpm type-check:app:check && pnpm type-check:config:check",
    "type-check:app": "vue-tsc -b tsconfig.app.json",
    "type-check:app:check": "vue-tsc --noEmit -p tsconfig.app.json",
    "type-check:config": "vue-tsc -b tsconfig.config.json",
    "type-check:config:check": "vue-tsc --noEmit -p tsconfig.config.json"
  },
  "dependencies": {
    "@ant-design/icons-vue": "^7.0.1",
    "@hey-api/client-axios": "^0.9.1",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/vue-query": "^5.89.0",
    "ant-design-vue": "~4.2.6",
    "axios": "^1.12.2",
    "dayjs": "^1.11.18",
    "driver.js": "^1.8.0",
    "echarts": "^6.0.0",
    "tailwindcss": "^4.1.18",
    "vue": "^3.5.18",
    "vue-page-review": "^0.6.0",
    "vue-router": "^4.5.1",
    "vue-types": "3",
    "vuex": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@hey-api/openapi-ts": "^0.97.1",
    "@playwright/test": "1.62.1",
    "@types/node": "^24.10.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/eslint-config-typescript": "^14.6.0",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.4.0",
    "jsdom": "^30.0.1",
    "openapi-typescript-codegen": "^0.29.0",
    "prettier": "3.6.2",
    "typescript": "^6.0.3",
    "unplugin-vue-router": "^0.19.2",
    "vite": "^7.1.2",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.0.15",
    "vue-tsc": "^3.2.2"
  }
}
