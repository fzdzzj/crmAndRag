# 本机 core.autocrlf=true，Windows checkout 会把文本转成 CRLF。
# shell 脚本与 git 钩子必须保持 LF，否则 bash 会以 $'\r' 语法错误直接失败。
*.sh text eol=lf
.githooks/* text eol=lf
# Java 源码跨平台统一纯 LF，消除 Windows 平台 Spotless 差异与 stat 缓存摩擦
*.java text eol=lf
# 文档与配置类文本统一纯 LF，消除 autocrlf 检出转换与本地换行门禁摩擦（卡 P-p）
*.md text eol=lf
*.txt text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.xml text eol=lf
*.properties text eol=lf
*.sql text eol=lf
*.json text eol=lf
.gitattributes text eol=lf
