<?xml version="1.0" encoding="UTF-8"?>
<!--
  链路 ID 进日志行。traceId 由 RequestTraceFilter 在请求入口写入 MDC，键名来自
  com.slz.crm.platform.trace.RequestTraceKey#TRACE_ID（值为 "traceId"），异步线程由
  MdcTaskDecorator 传播；%X{traceId:-} 的 ":-" 提供空默认值，使无 MDC 的线程
  （启动期、定时任务）渲染为空串而不是报错。
  级别仍由 application*.yml 的 logging.level.* 决定：Spring Boot 加载本文件后才套用这些
  属性，会覆盖下面的 root level，与本文件引入前语义一致。
-->
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <property name="CRM_CONSOLE_LOG_PATTERN"
              value="%d{${LOG_DATEFORMAT_PATTERN:-yyyy-MM-dd'T'HH:mm:ss.SSSXXX}} ${LOG_LEVEL_PATTERN:-%5p} ${PID:-} --- [%15.15t] [traceId=%X{traceId:-}] %-40.40logger{39} : %m%n${LOG_EXCEPTION_CONVERSION_WORD:-%wEx}"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${CRM_CONSOLE_LOG_PATTERN}</pattern>
            <charset>${CONSOLE_LOG_CHARSET}</charset>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
