<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.slz.crm.server.mapper.ContactTaskMapper">
    <delete id="deleteCommentByTaskIds" parameterType="java.util.List">
        delete from task_comment
        where task_id in
        <foreach item="taskId" collection="taskIds" separator="," open="(" close=")">
            #{taskId}
        </foreach>
    </delete>
</mapper>
