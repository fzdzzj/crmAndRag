<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.slz.crm.server.mapper.CustomerCompanyMapper">


    <select id="getCompanyByContactId" resultType="com.slz.crm.pojo.entity.CustomerCompanyEntity">
        select * from customer_company where id = (select company_id from customer_contact where id = #{id}) and is_deleted = false
    </select>
</mapper>