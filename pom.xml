<?xml version="1.0" encoding="UTF-8"?>
<!--
  融合平台基座 POM（Agent-0 · Wave 0）
  技术基线（已锁定，见 spec/.../design-decisions.md D1/D2/D4/D7）：
    · Spring Boot 3.5.x + Java 21（以 CRM 为基座，RAG 回填到该基线）
    · MyBatis-Plus 为唯一持久化（不引 JPA/Hibernate）
    · Spring AI（spring-ai-alibaba，dashscope 默认，可切 openai 兼容/vllm）；不引 LangChain4j
    · Qdrant + MinIO 作为平台基础设施；不引 Spring Security（认证统一由 CRM JWT 拦截器承担）
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <!-- D1：统一 Boot 3.5.x 基线（CRM 源仓为 3.5.5，保持一致以免回归） -->
        <version>3.5.5</version>
        <relativePath/>
    </parent>
    <groupId>com.slz</groupId>
    <artifactId>crm-platform</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>crm-platform</name>
    <description>以 CRM 为基座、AI 助手吸收 RAG 能力的融合平台单体（D5：单模块 + 包边界）</description>

    <properties>
        <java.version>21</java.version>
        <testcontainers.version>1.21.4</testcontainers.version>
        <spring-ai-alibaba.version>1.0.0.4</spring-ai-alibaba.version>
        <!-- 与 spring-ai-alibaba-core 1.0.0.4 传递的 Spring AI 版本保持一致（勿单独升级） -->
        <spring-ai.version>1.0.1</spring-ai.version>
        <mybatis-plus.version>3.5.6</mybatis-plus.version>
        <mybatis-plus-ext.version>3.5.9-EXT727</mybatis-plus-ext.version>
        <jjwt.version>0.12.5</jjwt.version>
        <springdoc.version>2.8.13</springdoc.version>
        <minio.version>8.5.7</minio.version>
        <qdrant-client.version>1.13.0</qdrant-client.version>
        <easyexcel.version>3.1.5</easyexcel.version>
        <jfreechart.version>1.5.3</jfreechart.version>
        <!-- test-hygiene 任务 3.1：byte-buddy-agent 版本实测自依赖树（mockito-core 5.17.0 传递 1.17.7），勿猜 -->
        <byte-buddy-agent.version>1.17.7</byte-buddy-agent.version>
        <byte-buddy-agent.path>${settings.localRepository}/net/bytebuddy/byte-buddy-agent/${byte-buddy-agent.version}/byte-buddy-agent-${byte-buddy-agent.version}.jar</byte-buddy-agent.path>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Spring AI Alibaba BOM：统一 Spring AI 与 dashscope 版本 -->
            <dependency>
                <groupId>com.alibaba.cloud.ai</groupId>
                <artifactId>spring-ai-alibaba-bom</artifactId>
                <version>${spring-ai-alibaba.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Testcontainers BOM：沿用 RAG 原仓 1.21.4，避免各模块版本漂移 -->
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- ==================== Web / 校验 / 可观测 ==================== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-cache</artifactId>
        </dependency>
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
        </dependency>
        <!-- Actuator：健康/指标；移除 Spring Security 后由 ActuatorProtectionFilter 保护（任务 3） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- Prometheus 注册表：/actuator/prometheus 供平台治理（Lane D）聚合指标 -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
        <!-- OpenAPI 契约导出（/v3/api-docs.yaml，供前端 openapi.yaml 同步，防止前后端契约漂移） -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>

        <!-- ==================== 持久化（D2：MyBatis-Plus 唯一，禁 JPA/Hibernate） ==================== -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-boot-starter</artifactId>
            <version>${mybatis-plus.version}</version>
        </dependency>
        <dependency>
            <groupId>org.mybatis</groupId>
            <artifactId>mybatis-spring</artifactId>
            <version>3.0.5</version>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!--
          com.tangzc auto-table：仅用于本地/测试便捷建表（H2 集成测试沿用 CRM 原机制）。
          生产 profile 必须 auto-table.mode=none，库结构由 Flyway 版本化迁移管理（任务 4）。
        -->
        <dependency>
            <groupId>com.tangzc</groupId>
            <artifactId>mybatis-plus-ext-spring-boot3-starter</artifactId>
            <version>${mybatis-plus-ext.version}</version>
        </dependency>
        <!-- Flyway：库结构唯一真相源；V1 基线为 CRM 现有 36 张表 -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <!-- Flyway 10+ 将 MySQL 方言拆到独立 artifact，必须显式引入 -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-mysql</artifactId>
        </dependency>

        <!-- ==================== AI 栈（D4：Spring AI + dashscope 默认，不引 LangChain4j） ==================== -->
        <dependency>
            <groupId>com.alibaba.cloud.ai</groupId>
            <artifactId>spring-ai-alibaba-starter-dashscope</artifactId>
        </dependency>
        <!--
          OpenAI 兼容客户端（contracts-frozen.md §1）：作为 DashScope compatible-mode 的 SSE 流式适配器。
          说明：DashScopeChatModel.stream() 走 DashScope 原生协议，usage 在流中不可靠；
          compatible-mode 走 OpenAI SSE 协议，可通过 streamUsage(true) 让最后一个 chunk 带 usage。
          版本必须与 spring-ai-alibaba-core 传递的 Spring AI 版本一致，避免模型类冲突。
        -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-openai</artifactId>
            <version>${spring-ai.version}</version>
        </dependency>

        <!-- ==================== 平台基础设施（D7：Qdrant + MinIO） ==================== -->
        <!--
          只引原生客户端，刻意不引 spring-ai-starter-vector-store-qdrant：
          其自动配置会在 Qdrant 不可达时阻断应用启动，而 D9 要求 dev/test 可回退内存 VectorStore。
          QdrantVectorStore 实现由 Lane B 提供（agent-execution-plan.md §3 归属）。
        -->
        <dependency>
            <groupId>io.qdrant</groupId>
            <artifactId>client</artifactId>
            <version>${qdrant-client.version}</version>
        </dependency>
        <dependency>
            <groupId>io.minio</groupId>
            <artifactId>minio</artifactId>
            <version>${minio.version}</version>
        </dependency>

        <!-- ==================== 认证（D3：CRM JWT 为唯一源，无 Spring Security） ==================== -->
        <!-- jjwt 归一到 0.12.5（RAG 原为 0.11.5，API 已变，统一由 CRM 侧 JwtUntil 使用） -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt</artifactId>
            <version>${jjwt.version}</version>
        </dependency>
        <!-- .env 注入：密钥/凭据不入库（任务 3） -->
        <dependency>
            <groupId>me.paulschwarz</groupId>
            <artifactId>spring-dotenv</artifactId>
            <version>4.0.0</version>
        </dependency>

        <!-- ==================== 业务通用件（CRM 原样并入所需） ==================== -->
        <dependency>
            <groupId>com.alibaba</groupId>
            <artifactId>easyexcel</artifactId>
            <version>${easyexcel.version}</version>
        </dependency>
        <dependency>
            <groupId>org.jfree</groupId>
            <artifactId>jfreechart</artifactId>
            <version>${jfreechart.version}</version>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>1.18.38</version>
        </dependency>

        <!-- B 知识库 PDF 解析（依赖变更申请：PDFBox 3.0.x，Loader.loadPDF API 为 3.x 专属） -->
        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>pdfbox</artifactId>
            <version>3.0.3</version>
        </dependency>
        <!-- ==================== 测试 ==================== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>mysql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>minio</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.rest-assured</groupId>
            <artifactId>rest-assured</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mybatis.spring.boot</groupId>
            <artifactId>mybatis-spring-boot-starter-test</artifactId>
            <version>3.0.5</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <source>21</source>
                    <target>21</target>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>1.18.38</version>
                        </path>
                        <path>
                            <groupId>com.tangzc</groupId>
                            <artifactId>mybatis-plus-ext-spring-boot3-starter</artifactId>
                            <version>${mybatis-plus-ext.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
            <!-- JaCoCo：覆盖率报告（门禁阈值由任务 18 CI 统一裁决，基座阶段不设硬门槛以免阻塞） -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.12</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!-- Surefire：单元测试（*Test.java）；*IT.java 交给 Failsafe，避免无 Docker 环境打断基线 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
                <configuration>
                    <includes>
                        <include>**/*Test.java</include>
                        <include>**/*Tests.java</include>
                    </includes>
                    <excludes>
                        <exclude>**/*IT.java</exclude>
                    </excludes>
                    <!-- test-hygiene 任务 3.1：@{argLine} 合并 JaCoCo（prepare-agent 注入的覆盖率参数），
                         再追加 -javaagent 挂载 byte-buddy-agent，消除 Mockito 动态加载 agent 警告；
                         漏 @{argLine} 会导致 JaCoCo 覆盖率静默失效 -->
                    <argLine>@{argLine} -javaagent:${byte-buddy-agent.path}</argLine>
                </configuration>
            </plugin>
            <!-- Failsafe：集成测试（*IT.java），含 H2 上下文与 Testcontainers MySQL 两类 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <version>3.5.2</version>
                <configuration>
                    <includes>
                        <include>**/*IT.java</include>
                        <include>**/*IntegrationTest.java</include>
                    </includes>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
