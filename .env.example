# ================================================================
# 融合平台环境变量模板（复制为 .env 后按需填写；.env 已被 .gitignore 排除）
# 敏感项必须外置，禁止把真实密钥写入仓库（任务 3）
# ================================================================

# ---------- 运行 profile ----------
SPRING_PROFILES_ACTIVE=dev

# ---------- MySQL ----------
SLZ_DATASOURCE_HOST=127.0.0.1
SLZ_DATASOURCE_PORT=3306
SLZ_DATASOURCE_DATABASE=crm
SLZ_DATASOURCE_USERNAME=root
SLZ_DATASOURCE_PASSWORD=

# ---------- JWT（HS256，建议 >=32 字节随机串） ----------
SLZ_JWT_SECRET_KEY=
SLZ_JWT_TTL=3600000

# ---------- 附件下载令牌（AES-256，32 字节） ----------
SLZ_ATTACH_TOKEN_KEY=

# ---------- 管理员初始化（仅首启） ----------
SLZ_ADMIN_EMAIL=admin@slz.com
SLZ_ADMIN_PASSWORD=admin123

# ---------- 通义千问 / Spring AI ----------
DASHSCOPE_API_KEY=

# ---------- 模型 Provider 抽象（dashscope 默认） ----------
SLZ_AI_PROVIDER=dashscope
SLZ_AI_BASE_URL=
SLZ_AI_API_KEY=
SLZ_AI_CHAT_MODEL=qwen-plus
SLZ_AI_VISION_MODEL=qwen-vl-plus
SLZ_AI_EMBEDDING_MODEL=text-embedding-v3

# ---------- Qdrant ----------
QDRANT_HOST=localhost
QDRANT_PORT=6334
QDRANT_TLS=false
QDRANT_API_KEY=
QDRANT_COLLECTION=knowledge_chunk
QDRANT_DIMS=1024
RAG_VECTOR_PROVIDER=qdrant

# ---------- MinIO ----------
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=knowledge-files

# ---------- 基座开关 ----------
SLZ_FLYWAY_ENABLED=true
SLZ_AUTO_TABLE_MODE=none
SLZ_ACTUATOR_PROTECTED=true
SLZ_FILE_PATH=./file
